#!/usr/bin/env bash
# wotd — bash "word of the day": picks a semi-useful CLI command you might
# not know well yet, and prints its tldr page.
set -euo pipefail

VERSION="1.0.0"

# Curated roster of real-world-useful, non-trivial commands.
# Deliberately excludes day-one basics (ls, cd, cp, mv, cat, echo, pwd, mkdir, rm).
COMMANDS=(
  grep sed awk cut tr sort uniq comm join paste column wc diff patch
  rev tac shuf split csplit xxd hexdump base64 md5sum sha256sum dos2unix iconv
  find xargs realpath stat file mktemp ln install dirname basename du df pushd popd
  curl wget ssh scp rsync ssh-copy-id ssh-keygen dig nc nmap ss netstat whois traceroute ping
  ps top htop kill pkill pgrep lsof strace ltrace ldd nm objdump
  nice renice ionice flock timeout watch tee nohup jobs disown wait
  chmod chown umask crontab at
  history alias export source read printf seq trap type env date bc expr yes sleep mkfifo dd
  socat parallel ncdu journalctl systemctl tmux screen openssl jq tar less man which fc
)

usage() {
  cat <<EOF
wotd $VERSION — bash command of the day

Usage:
  wotd            Pick a random command from the roster and show its tldr
  wotd <command>  Show the tldr page for a specific command
  wotd -l         List every command in the roster
  wotd -h         Show this help

Roster size: ${#COMMANDS[@]} commands.
Requires the 'tldr' client (brew install tldr) to render pages.
EOF
}

require_tldr() {
  if ! command -v tldr >/dev/null 2>&1; then
    echo "wotd: the 'tldr' command isn't installed." >&2
    echo "      install it with: brew install tldr" >&2
    exit 1
  fi
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;
  -l|--list)
    printf '%s\n' "${COMMANDS[@]}" | sort
    exit 0
    ;;
esac

require_tldr

if [[ -n "${1:-}" ]]; then
  pick="$1"
else
  pick="${COMMANDS[$((RANDOM % ${#COMMANDS[@]}))]}"
fi

echo "today's pick: $pick"
echo
exec tldr "$pick"
